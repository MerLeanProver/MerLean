# Mem0-g environment — OpenAI API key.
# Deploy writes this as repo-root .env (and preserves an existing valid .env), or you can set
# OPENAI_API_KEY in your environment.
# Get a key at https://platform.openai.com/api-keys (API billing is separate from any ChatGPT
# subscription). Mem0-g uses gpt-4o-mini + text-embedding-3-small, so a few dollars lasts a long time.

OPENAI_API_KEY=sk-...

# Optional overrides:
# PLAN_LLM_MODEL=gpt-4o-mini
# PLAN_EMBED_MODEL=text-embedding-3-large
# PLAN_EMBED_DIMS=3072
# PLAN_RERANK_MODEL=gpt-4o-mini
# PLAN_SUMMARY_MODEL=gpt-4o-mini
